<link href="/public/plugins/sweet-alert2/sweetalert2.min.css" rel="stylesheet" type="text/css">

<div class="content">
    <div class="container-fluid">

        <!-- Page Title -->
        <div class="row">
            <div class="col-sm-12">
                <div class="page-title-box">
                    <h4 class="page-title"><%= title %></h4>

                    <ol class="breadcrumb">
                        <li class="breadcrumb-item">
                            <a href="/dashboard">Pinly</a>
                        </li>

                        <li class="breadcrumb-item active">
                            Categories
                        </li>
                    </ol>
                </div>
            </div>
        </div>

        <!-- Categories List -->
        <div class="row">
            <div class="col-12">

                <div class="card m-b-20">

                    <div class="card-body">

                        <div class="d-flex justify-content-between align-items-center mb-3">

                            <a
                                href="/add-category"
                                class="btn btn-outline-secondary">

                                <i class="fas fa-plus"></i>
                                Add Category

                            </a>

                        </div>

                        <table
                            id="datatable"
                            class="table table-bordered table-striped">

                            <thead>

                                <tr>

                                    <th width="80">#</th>

                                    <th>Name</th>

                                    <th>Slug</th>

                                    <th>Status</th>

                                    <th width="170">
                                        Action
                                    </th>

                                </tr>

                            </thead>

                            <tbody>

                                <% if (categories && categories.length > 0) { %>

                                    <% categories.forEach(function(category,index){ %>

                                        <tr>

                                            <td>
                                                <%= index + 1 %>
                                            </td>

                                            <td>
                                                <%= category.name %>
                                            </td>

                                            <td>
                                                <%= category.slug %>
                                            </td>

                                            <td>

                                                <% if(category.status){ %>

                                                    <span class="badge badge-success">
                                                        Active
                                                    </span>

                                                <% }else{ %>

                                                    <span class="badge badge-danger">
                                                        Inactive
                                                    </span>

                                                <% } %>

                                            </td>

                                            <td>

                                                <a
                                                    href="/categories/edit/<%= category.id %>"
                                                    class="btn btn-outline-primary btn-sm">

                                                    <i class="fas fa-pencil-alt"></i>

                                                </a>

                                                <button
                                                    class="btn btn-outline-danger btn-sm delete-category"
                                                    data-id="<%= category.id %>">

                                                    <i class="far fa-trash-alt"></i>

                                                </button>

                                            </td>

                                        </tr>

                                    <% }) %>

                                <% } else { %>

                                    <tr>

                                        <td colspan="5" class="text-center">

                                            No Categories Found.

                                        </td>

                                    </tr>

                                <% } %>

                            </tbody>

                        </table>

                    </div>

                </div>

            </div>
        </div>

    </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<!-- <script src="/public/plugins/sweet-alert2/sweetalert2.min.js"></script> -->
<script src="/public/assets/pages/categories.js"></script>